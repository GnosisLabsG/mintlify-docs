{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mind-e",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "User Guide",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "Introduction",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Essentials",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/settings",
              "essentials/navigation",
              "essentials/reusable-snippets"
            ]
          }
        ]
      },
      {
        "tab": "Technical Guide",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-tab/Developer-Overview"
            ]
          },
          {
            "group": "Identity Verification",
            "pages": [
              "api-tab/Identity-Verification"
            ]
          },
          {
            "group": "API",
            "pages": [
              "api-tab/API-Documentation"
            ]
          },
          {
            "group": "Endpoint Examples",
            "pages": [
              "api-tab/endpoint/get",
              "api-tab/endpoint/create",
              "api-tab/endpoint/delete",
              "api-tab/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://mind-e.co/dashboard",
          "icon": "chart-line"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/mind-e",
          "icon": "discord"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/mind-e",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png",
    "href": "https://mind-e.co"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mind-e.co"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://mind-e.co/dashboard"
    }
  },
  "footer": {
    "socials": {
      "x": "https://twitter.com/mind_e_co",
      "github": "https://github.com/mind-e",
      "linkedin": "https://linkedin.com/company/mind-e"
    }
  }
